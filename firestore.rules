rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/pengguna/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : getUserData().role;
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || getUserRole() == 'ADMIN');
    }

    function isTeacher() {
      return isSignedIn() && (getUserRole() == 'guru' || getUserRole() == 'GURU' || getUserRole() == 'TEACHER');
    }

    function isHomeroomTeacher() {
      return isSignedIn() && (getUserRole() == 'wali_kelas' || getUserRole() == 'WALI_KELAS');
    }

    function isStudent() {
      return isSignedIn() && (getUserRole() == 'siswa' || getUserRole() == 'SISWA');
    }

    function isParent() {
      return isSignedIn() && (getUserRole() == 'orang_tua' || getUserRole() == 'ORANG_TUA');
    }

    // 1. Koleksi: sekolah
    match /sekolah/{sekolahId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Koleksi: pengguna & users (Profile)
    match /pengguna/{userUid} {
      allow read: if isSignedIn() && (request.auth.uid == userUid || isTeacher() || isHomeroomTeacher() || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userUid || isAdmin());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacher() || isHomeroomTeacher() || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Koleksi: tahunAjaran, kelas, mapel, subMateri, periode
    match /tahunAjaran/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /kelas/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /mapel/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /subMateri/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /periode/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // 4. Koleksi: penugasan, keanggotaanKelas, relasiOrangTua
    match /penugasan/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /keanggotaanKelas/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /relasiOrangTua/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // 5. Koleksi: nilai & koreksiNilai & scores & grades
    match /nilai/{nilaiId} {
      allow read: if isSignedIn() && (isTeacher() || isHomeroomTeacher() || isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid) || isParent());
      allow write: if isSignedIn() && (isTeacher() || isAdmin());
    }

    match /scores/{scoreId} {
      allow read: if isSignedIn() && (isTeacher() || isHomeroomTeacher() || isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid) || isParent());
      allow write: if isSignedIn() && (isTeacher() || isAdmin());
    }

    match /grades/{gradeId} {
      allow read: if isSignedIn() && (isTeacher() || isHomeroomTeacher() || isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid) || isParent());
      allow write: if isSignedIn() && (isTeacher() || isAdmin());
    }

    match /koreksiNilai/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isTeacher() || isAdmin());
    }

    // 6. Notifikasi & Sesi & Insight
    match /notifikasi/{id} { allow read, write: if isSignedIn(); }
    match /sesiPerangkat/{id} { allow read, write: if isSignedIn(); }
    match /insightCache/{id} { allow read, write: if isSignedIn(); }
    match /insights/{insightId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /subjects/{subjectId} { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /topics/{topicId} { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
  }
}
